{
  "name": "personal-accounting-mini-program",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:mp": "uni -p mp-weixin",
    "build:mp": "uni build -p mp-weixin",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "for d in cloudfunctions/*/; do echo \">>> install $d\" && cd \"$d\" && npm install && cd \"$OLDPWD\"; done",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests"
  },
  "dependencies": {
    "@dcloudio/uni-app": "^3.0.0-alpha-5010120260519001",
    "@dcloudio/uni-mp-weixin": "^3.0.0-alpha-5010120260519001",
    "@dcloudio/vite-plugin-uni": "^3.0.0-alpha-5010120260519001",
    "decimal.js": "^10.6.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.0",
    "@vue/vue3-jest": "^29.2.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^3.3.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/tests",
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.spec.ts",
      "**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^wx-server-sdk$": "<rootDir>/__mocks__/wx-server-sdk.js"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.vue$": "./jest/vue-transform.js"
    }
  }
}
